{
  "name": "@base/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": { ".": "./src/index.ts", "./schema": "./src/schema.ts" },
  "scripts": {
    "migrate": "node --env-file=../../.env src/migrate.mjs",
    "seed": "node --env-file=../../.env src/seed.mjs",
    "reset": "node --env-file=../../.env src/reset.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base/permissions": "workspace:*",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.36.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
